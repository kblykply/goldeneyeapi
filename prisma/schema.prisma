generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UnitType {
  STUDIO
  ONE_PLUS_ONE
  TWO_PLUS_ONE
}

enum PaymentPlan {
  PESIN
  ALTIN
  TAKSIT_12
}

enum Role {
  ADMIN
  REGIONAL_MANAGER
  REGIONAL_LEADER
  AGENCY
  SPECIAL
  AUTHORITY
  USER
}

enum ContractStatus {
  DRAFT
  CUSTOMER_CONFIRM_PENDING
  CUSTOMER_CONFIRMED
  PENDING_MANAGER_APPROVAL
  APPROVED
  REJECTED
}

enum PresentationStatus {
  CREATED
  OTP_SENT
  OPENED
  ENDED
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role     Role    @default(USER)
  level    Int     @default(1)
  isActive Boolean @default(true)

  fullName  String
  phoneE164 String @unique
  password  String

  lastSeenAt DateTime?
  avatarUrl  String?

  commissionRate Float?   // only for SPECIAL role

  leaderId String?
  leader   User?   @relation("LeaderToDownline", fields: [leaderId], references: [id])
  downline User[]  @relation("LeaderToDownline")

  presentations Presentation[]

  // salesperson -> contracts
  contractsSold Contract[] @relation("SalespersonContracts")

  // ✅ approvedBy -> contracts (OPPOSITE: Contract.approvedBy)
  contractsApproved Contract[] @relation("ApprovedContracts")

  // ✅ manager approvals (OPPOSITE: Contract.manager)
  contractsManaged Contract[] @relation("ManagerContracts")

  // audit actor
  auditLogs AuditLog[] @relation("AuditActor")

  commissions   Commission[]
  refreshTokens RefreshToken[]
  contractNotes ContractNote[] @relation("ContractNoteAuthor")
  customerNotes CustomerNote[] @relation("CustomerNoteAuthor")

  notificationsTriggered Notification[]     @relation("NotificationActor")
  notificationsReceived  Notification[]     @relation("NotificationRecipient")
  notificationReads      NotificationRead[]
}

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  fullName  String
  phoneE164 String @unique

  presentations Presentation[]
  contracts     Contract[]
  notes         CustomerNote[]
}

model Presentation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status PresentationStatus @default(CREATED)

  salespersonId String
  salesperson   User   @relation(fields: [salespersonId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  otpHash   String?
  otpSentAt DateTime?
  openedAt  DateTime?
  endedAt   DateTime?

  durationSec Int @default(0)

  ipAddress String?
  userAgent String?

  auditLogs AuditLog[] @relation("AuditPresentation")

  // Wizard state
  step           Int     @default(1)
  videoCompleted Boolean @default(false)

  unitType    UnitType?
  weekOfYear  Int?
  paymentPlan PaymentPlan?
  basePriceCents Int?

  // ✅ OPPOSITE for Contract.presentation
  contracts Contract[] @relation("PresentationContracts")
}

model Commission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  level       Int
  rate        Float // payout delta rate e.g. 0.16 / 0.02
  baseAmountCents Int

  status CommissionStatus @default(PENDING)

  @@index([contractId])
  @@index([userId])
}

model CommissionConfig {
  id         String   @id @default(cuid())
  updatedAt  DateTime @updatedAt

  rmRate     Float    @default(0.225)
  rlRate     Float    @default(0.20)
  adminRate  Float    @default(0.26)
  agencyRate Float    @default(0.20)
  lvl3Rate   Float    @default(0.15)
  lvl2Rate   Float    @default(0.125)
  lvl1Rate   Float    @default(0.10)
}

enum CommissionStatus {
  PENDING
  PAYABLE
  PAID
}

model Contract {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  status    ContractStatus @default(DRAFT)

  // relations
  presentationId String?
  presentation   Presentation? @relation("PresentationContracts", fields: [presentationId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  salespersonId String
  salesperson   User   @relation("SalespersonContracts", fields: [salespersonId], references: [id])

  // ✅ approvedBy (fixes contractsApproved error)
  approvedById String?
  approvedBy   User?   @relation("ApprovedContracts", fields: [approvedById], references: [id])

  managerId String?
  manager   User?   @relation("ManagerContracts", fields: [managerId], references: [id])

  // pricing snapshot
  unitType    UnitType
  weekOfYear  Int
  paymentPlan PaymentPlan
  basePriceCents Int

  // OTP
  customerOtpHash     String?
  customerOtpSentAt   DateTime?
  customerConfirmedAt DateTime?

  rejectedReason String?

  // Customer details snapshot (collected before OTP)
  nationality    String?
  passportNumber String?
  email          String?
  address        String?

  // ✅ OPPOSITE for AuditLog.contract
  auditLogs AuditLog[] @relation("AuditContract")

  commissions       Commission[]
  customPaymentPlan CustomPaymentPlan?
  notes             ContractNote[]
}

model CustomPaymentPlan {
  id         String   @id @default(cuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id])
  baseTotalCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  installments CustomPaymentInstallment[]

  @@map("custom_payment_plans")
}

model CustomPaymentInstallment {
  id          String            @id @default(cuid())
  planId      String
  plan        CustomPaymentPlan @relation(fields: [planId], references: [id])
  dueDate     DateTime
  baseAmountCents Int
  label       String?
  isPaid      Boolean           @default(false)
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([planId])
  @@map("custom_payment_installments")
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  entityType String
  entityId   String
  action     String
  meta       Json?

  ipAddress String?
  userAgent String?

  presentationId String?
  presentation   Presentation? @relation("AuditPresentation", fields: [presentationId], references: [id])

  contractId String?
  contract   Contract? @relation("AuditContract", fields: [contractId], references: [id])
}

model WeekPrice {
  id         String   @id @default(cuid())
  unitType   UnitType
  weekOfYear Int

  // ✅ date range text from excel (e.g. "1 Kasım - 8 Kasım")
  periodText String

  cashCents          Int
  installment6Cents  Int
  installment12Cents Int

  @@unique([unitType, weekOfYear])
  @@index([unitType])
  @@index([weekOfYear])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   // base: "EUR"
  toCurrency   String   // "EUR" | "GBP" | "USD" | "TRY"
  rate         Decimal  @db.Decimal(18, 6)
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

enum OtpPurpose {
  LOGIN
  PRESENTATION_OPEN
  CONTRACT_CONFIRM
}

model OtpCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  phoneE164 String
  purpose   OtpPurpose

  otpHash    String
  attempts   Int       @default(0)
  consumedAt DateTime?

  meta Json?

  @@index([phoneE164, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id])

  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model ContractNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  authorId String
  author   User   @relation("ContractNoteAuthor", fields: [authorId], references: [id])

  body String

  @@index([contractId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CustomerNoteAuthor", fields: [authorId], references: [id])

  body String

  @@index([customerId])
}

enum NotificationType {
  PRESENTATION_STARTED
  PRESENTATION_ENDED
  CONTRACT_PENDING_APPROVAL
  USER_LEADER_CHANGED
  USER_LEVEL_CHANGED
}

model Notification {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())

  type       NotificationType
  title      String
  body       String

  actorId    String
  actor      User             @relation("NotificationActor", fields: [actorId], references: [id])

  recipientId String?
  recipient   User?            @relation("NotificationRecipient", fields: [recipientId], references: [id])

  entityId   String?
  entityType String?

  reads      NotificationRead[]

  @@index([actorId])
  @@index([recipientId])
  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  readAt         DateTime     @default(now())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])

  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId])
}

enum ApartmentStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  UNDER_DEVELOPMENT
}

model Apartment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      ApartmentStatus @default(AVAILABLE)
  address     String
  sqft        Float
  priceUsd    Float

  title       String?
  description String?
  floor       Int?
  roomCount   Int?

  images      ApartmentImage[]
}

model ApartmentImage {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  url         String
  isCover     Boolean   @default(false)
  order       Int       @default(0)

  @@index([apartmentId])
  @@map("apartment_images")
}

model News {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  source   String
  date     String
  link     String
  imageUrl String?
}

model BlogPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title         String
  excerpt       String
  content       String   @db.Text
  date          String
  category      String
  coverImageUrl String?
}
